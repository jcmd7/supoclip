# Mission Control — single config surface. Copy to .env and fill what you use.
#   cp .env.example .env
# Everything has a sane default; you only need keys for the features you turn on.
# Nothing here is required to start the zero-key core (`make lite`).
# (SupoClip's own detailed reference lives in apps/supoclip/.env.example.)

# ─── LLM (SupoClip clip selection, MiroFish sims, Storyboard stages) ──────────
# Any OpenAI-compatible endpoint. Point at local Ollama for free, or a cloud key.
LLM=google-gla:gemini-3-flash-preview      # SupoClip format: provider:model
GOOGLE_API_KEY=                            # or OPENAI_API_KEY / ANTHROPIC_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Storyboard Conceptor LLM (OpenAI-compatible). For free local: Ollama.
STORYBOARD_LLM_BASE_URL=http://localhost:11434/v1
STORYBOARD_LLM_KEY=
STORYBOARD_LLM_MODEL=llama3.2

# ─── Transcription (SupoClip + /clip) ────────────────────────────────────────
ASSEMBLY_AI_API_KEY=                       # optional; faster-whisper is the free default

# ─── /clip extras ────────────────────────────────────────────────────────────
PEXELS_API_KEY=                            # stock B-roll (free)
HF_TOKEN=                                  # WhisperX speaker diarization (free)

# ─── Watcher → phone push (ntfy) ─────────────────────────────────────────────
NTFY_TOPIC=                                # set a secret topic name to enable pushes
MARKET_MOVE_THRESHOLD=8                     # pct points/24h to alert on
HN_POINTS_THRESHOLD=600
WATCH_KEYWORDS=                            # e.g. fed,bitcoin,ai (empty = all)

# ─── MiroFish (prediction sims) ──────────────────────────────────────────────
MIROFISH_LLM_API_KEY=                      # cheap model recommended (token-heavy)
MIROFISH_LLM_BASE_URL=http://localhost:11434/v1
MIROFISH_LLM_MODEL=llama3.2
ZEP_API_KEY=                               # agent memory (free tier)

# ─── Flowsint (OSINT) — generate secrets: openssl rand -hex 32 ───────────────
AUTH_SECRET=
MASTER_VAULT_KEY_V1=
NEO4J_PASSWORD=

# ─── Storage paths (defaults are fine) ───────────────────────────────────────
CLIPS_DIR=~/.mission-control/clips
STORYBOARD_DIR=~/.mission-control/storyboards
